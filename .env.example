# ============================================================================
# SEDIMA Parc — variables d'environnement
#
# Copier ce fichier en `.env.local` pour le développement, et poser les mêmes
# clés dans Vercel (Project Settings › Environment Variables).
#
# Tant qu'aucune de ces clés n'est posée, l'application tourne sur son jeu de
# démonstration : c'est voulu, et c'est ce qui permet de la montrer sans base.
# ============================================================================

# Projet Supabase dédié à SEDIMA Parc.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service — jamais exposée au navigateur, usage serveur uniquement.
# À poser dans Vercel en variable *non* préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Répertoire de construction. Utile en local quand OneDrive verrouille .next ;
# inutile sur Vercel, qui gère le sien.
# NEXT_DIST_DIR=.next-local
